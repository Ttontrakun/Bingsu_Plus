{
  "name": "all-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node main.js",
    "dev": "node --watch main.js",
    "prisma:generate": "prisma generate --schema=infrastructure/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=infrastructure/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=infrastructure/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=infrastructure/prisma/schema.prisma",
    "seed:admins": "node scripts/seed-admins.js",
    "seed:help-bot": "node scripts/seed-help-bot.js",
    "reindex:documents": "node scripts/reindex-documents.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.697.0",
    "@google/genai": "^1.29.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "pdfjs-dist": "^4.10.38",
    "redis": "^4.7.0",
    "undici": "^7.21.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  }
}
