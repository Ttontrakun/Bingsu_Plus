# Copy to .env.local (recommended) for local development

# Node legacy API server (FastAPI main proxies to this)
PORT=5052

# FastAPI proxy target (main API -> legacy)
LEGACY_API_URL="http://localhost:5052"

# Postgres
# NOTE: docker-compose.yml maps Postgres to localhost:5434 (to avoid conflicts)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/ask_the_manual?schema=public"

# Redis + Qdrant
REDIS_URL="redis://localhost:6380"
QDRANT_URL="http://localhost:6334"
UPLOAD_QUEUE_MODE="memory"

# CORS (when running frontend on port 3000)
CORS_ORIGINS="http://localhost:3000"

# Chat (primary) - OpenAI gateway compatible
GATEWAY_BASE_URL="https://aigateway.ntictsolution.com/v1"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Chat fallback (used when gateway is unreachable)
GEMINI_API_KEY=""
# GEMINI_CHAT_MODEL="models/gemini-2.0-flash"

# Embeddings for upload + RAG (choose ONE provider)
# - gemini: uses GEMINI_API_KEY + EMBEDDING_MODEL like "models/gemini-embedding-001"
# - openai: uses EMBEDDING_API_KEY + EMBEDDING_BASE_URL + EMBEDDING_MODEL like "text-embedding-3-large"
EMBEDDING_PROVIDER="gemini"
EMBEDDING_MODEL="models/gemini-embedding-001"

# OpenAI embeddings (only used when EMBEDDING_PROVIDER="openai")
EMBEDDING_BASE_URL="https://api.openai.com/v1"
EMBEDDING_API_KEY=""

# If you switch embedding model/provider, use a NEW collection to avoid vector-size mismatch,
# then reindex: `npm run reindex:documents`
# QDRANT_COLLECTION="documents_openai"

# Raw/original file storage policy
# - When "false": keep only extracted text/blocks + embeddings for RAG, and do NOT store original files.
# - This also disables the original file download endpoint.
STORE_RAW_FILES="false"

# Timeouts
CHAT_TIMEOUT_MS=30000
# GATEWAY_CONNECT_TIMEOUT_MS=30000

# OCR (optional) - Node backend calls OCR_API_URL/api/ocr/extract
# เปิดเป็น true เมื่อพร้อมใช้ OCR (ต้องมี TYPHOON_OCR_API_KEY ถ้าใช้ provider=typhoon)
OCR_ENABLED="true"
OCR_API_URL="http://localhost:5051"
OCR_LANG="th"
OCR_MAX_PAGES=30

# OCR Provider (runs inside FastAPI service under backend/)
# - "paddle": local PaddleOCR (no API key; โหลดโมเดลครั้งแรกหนัก)
# - "typhoon": เรียก OpenTyphoon OCR API (ต้องใส่ TYPHOON_OCR_API_KEY ด้านล่าง)
OCR_PROVIDER="typhoon"
# คีย์จาก OpenTyphoon — ต้องใส่ถ้า OCR_PROVIDER=typhoon
TYPHOON_OCR_API_KEY=""

